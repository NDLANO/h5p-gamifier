[
  {
    "name": "titleScreen",
    "type": "group",
    "label": "Title screen",
    "importance": "low",
    "fields": [
      {
        "name": "showTitleScreen",
        "type": "boolean",
        "label": "Show title screen",
        "description": "If checked, a title screen will be shown before the contents.",
        "default": false
      },
      {
        "name": "title",
        "type": "text",
        "label": "Title",
        "description": "If left empty, the title of this content will be used.",
        "optional": true
      },
      {
        "name": "introduction",
        "type": "text",
        "widget": "html",
        "label": "Introduction",
        "optional": true,
        "enterMode": "p",
        "tags": [
          "sub",
          "sup",
          "strong",
          "em",
          "p",
          "code"
        ]
      },
      {
        "name": "image",
        "type": "image",
        "label": "Image",
        "optional": true
      },
      {
        "name": "imageAltText",
        "type": "text",
        "label": "Alternative text for image",
        "description": "Describe what can be seen in the image. The text is read by text-to-speech tools needed by visually impaired users.",
        "optional": true
      }
    ]
  },
  {
    "name": "content",
    "type": "list",
    "label": "List of contents",
    "importance": "high",
    "widgets": [
      {
        "name": "VerticalTabs",
        "label": "Default"
      }
    ],
    "min": 1,
    "entity": "content",
    "field": {
      "name": "content",
      "type": "group",
      "fields": [
        {
          "name": "libraryParams",
          "type": "library",
          "label": "Content",
          "importance": "high",
          "options": [
            "H5P.DragQuestion 1.15",
            "H5P.DragText 1.10",
            "H5P.Blanks 1.14",
            "H5P.ImageHotspotQuestion 1.8",
            "H5P.MarkTheWords 1.11",
            "H5P.MultiChoice 1.16",
            "H5P.SortParagraphs 0.12",
            "H5P.Summary 1.10",
            "H5P.AdvancedText 1.1",
            "H5P.VocabularyDrill 1.2",
            "H5P.Audio 1.5",
            "H5P.Video 1.6",
            "H5P.Accordion 1.0",
            "H5P.Agamotto 1.7",
            "H5P.Crossword 0.7",
            "H5P.Essay 1.6",
            "H5P.Image 1.1",
            "H5P.ImageHotspots 1.11",
            "H5P.MemoryGame 1.3",
            "H5P.MultiMediaChoice 0.3",
            "H5P.TrueFalse 1.8"
          ]
        },
        {
          "name": "attempts",
          "type": "number",
          "label": "Attempts",
          "description": "Number of attempts a user has to complete the content.",
          "min": 1,
          "optional": true
        },
        {
          "name": "timeLimit",
          "type": "number",
          "label": "Time limit",
          "description": "Optional time limit in seconds. If a user exceeds this time, the exercise cannot be edited anymore.",
          "min": 1,
          "optional": true
        }
      ]
    }
  },
  {
    "name": "audio",
    "type": "group",
    "importance": "low",
    "label": "Audio settings",
    "fields": [
      {
        "name": "backgroundMusic",
        "type": "audio",
        "label": "Background music",
        "optional": true
      },
      {
        "name": "events",
        "type": "group",
        "label": "Event sounds",
        "importance": "low",
        "fields": [
          {
            "name": "goto",
            "type": "audio",
            "label": "Go previous/next content",
            "description": "Sound played when navigating to the previous or next content.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          },
          {
            "name": "correctAnswer",
            "type": "audio",
            "label": "Correct answer",
            "description": "Will be played when the user answers correctly.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          },
          {
            "name": "wrongAnswer",
            "type": "audio",
            "label": "Wrong answer",
            "description": "Will be played when the user answers incorrectly.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          },
          {
            "name": "lostLife",
            "type": "audio",
            "label": "Lost a life",
            "description": "Will be played when the user loses a life.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          },
          {
            "name": "attemptsExceeded",
            "type": "audio",
            "label": "Attempts exceeded",
            "description": "Will be played when the user exceeds the maximum number of attempts for an exercise.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          },
          {
            "name": "timeWarningGlobal",
            "type": "audio",
            "label": "Global time warning",
            "description": "Sound played when the global time is about to expire.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          },
          {
            "name": "timeExpired",
            "type": "audio",
            "label": "Time expired",
            "description": "Sound played when the time is up for one exercise.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          },
          {
            "name": "timeExpiredTotal",
            "type": "audio",
            "label": "Time expired total",
            "description": "Sound played when the time is up for all exercises.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          },
          {
            "name": "dialogOpened",
            "type": "audio",
            "label": "Dialog opened",
            "description": "Sound played when a dialog is opened.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          },
          {
            "name": "dialogClosed",
            "type": "audio",
            "label": "Dialog closed",
            "description": "Sound played when a dialog is closed.",
            "optional": true,
            "widgetExtensions": [
              "GameSounds"
            ]
          }
        ]
      }
    ]
  },
  {
    "name": "visuals",
    "type": "group",
    "importance": "low",
    "label": "Visual settings",
    "fields": [
      {
        "name": "animate",
        "type": "boolean",
        "label": "Animate elements",
        "description": "Enable animations for various elements. Users' explicit wish to reduce motion (e.g., via browser settings) will be respected automatically regardless of this setting.",
        "default": true
      },
      {
        "name": "dummy",
        "type": "boolean",
        "label": "Dummy",
        "widget": "none"
      }
    ]
  },
  {
    "name": "behaviour",
    "type": "group",
    "importance": "low",
    "label": "Behavioural settings",
    "fields": [
      {
        "name": "globalTimeLimit",
        "type": "number",
        "label": "Global time limit",
        "description": "Optional global time limit in seconds. If a user exceeds this time, all the exercises cannot be edited anymore.",
        "min": 1,
        "optional": true
      },
      {
        "name": "timeWarningGlobal",
        "type": "number",
        "label": "Global time warning",
        "description": "Optional time in seconds before the global time expires to show a warning.",
        "min": 1,
        "optional": true
      },
      {
        "name": "cycle",
        "type": "boolean",
        "label": "Cycle through contents",
        "description": "Go back to first item after last and vide versa.",
        "default": false
      },
      {
        "name": "displayPageAnnouncement",
        "type": "boolean",
        "label": "Display current page in toolbar",
        "default": true
      },
      {
        "name": "displayContentAnnouncement",
        "type": "boolean",
        "label": "Display content title in toolbar",
        "default": true
      },
      {
        "name": "enableRetry",
        "type": "boolean",
        "label": "Enable \"Retry\"",
        "description": "If checked, users can reset all contents on the result screen.",
        "default": true
      },
      {
        "name": "enableSolutionsButton",
        "type": "boolean",
        "label": "Enable \"Show solutions\"",
        "description": "If checked, users can display the solutions of all contents from the result screen.",
        "default": true
      }
    ]
  },
  {
    "name": "l10n",
    "type": "group",
    "label": "User interface",
    "common": true,
    "fields": [
      {
        "name": "pageAnnouncement",
        "type": "text",
        "label": "Page announcement",
        "default": "@current / @total",
        "description": "@current and @total are placeholders and will be replaced by the respective values."
      },
      {
        "name": "noTitle",
        "type": "text",
        "label": "Content without a title",
        "default": "Untitled"
      },
      {
        "name": "previousContentLabel",
        "type": "text",
        "label": "Previous content button",
        "default": "Previous"
      },
      {
        "name": "nextContentLabel",
        "type": "text",
        "label": "Next content button",
        "default": "Next"
      },
      {
        "name": "timeExpiredExercise",
        "type": "text",
        "label": "Time expired for exercise",
        "default": "You ran out of time for this exercise!"
      },
      {
        "name": "timeExpiredGlobal",
        "type": "text",
        "label": "Time expired for global",
        "default": "You ran out of time for this content!"
      },
      {
        "name": "attemptsExceeded",
        "type": "text",
        "label": "Attempts exceeded for exercise",
        "default": "You have exceeded the maximum number of attempts for this exercise."
      },
      {
        "name": "settings",
        "type": "text",
        "label": "Settings",
        "default": "Settings"
      },
      {
        "name": "volumeMusic",
        "type": "text",
        "label": "Volume of music",
        "default": "Volume of music"
      },
      {
        "name": "volumeSFX",
        "type": "text",
        "label": "Volume of sound effects",
        "default": "Volume of sound effects"
      },
      {
        "name": "startButton",
        "type": "text",
        "label": "Start button",
        "default": "Start"
      },
      {
        "name": "resultsHeader",
        "type": "text",
        "label": "Results header",
        "default": "Your results"
      },
      {
        "name": "scoreBanner",
        "type": "text",
        "label": "Score",
        "default": "@score of @total points",
        "description": "@score and @total are placeholders and will be replaced by the respective values."
      },
      {
        "name": "viewedBanner",
        "type": "text",
        "label": "Viewed contents (if there are no tasks)",
        "default": "@viewed of @total contents viewed",
        "description": "@viewed and @total are placeholders and will be replaced by the respective values."
      },
      {
        "name": "contentColumnHeader",
        "type": "text",
        "label": "Content column header",
        "default": "Content"
      },
      {
        "name": "scoreColumnHeader",
        "type": "text",
        "label": "Score column header",
        "default": "Score"
      },
      {
        "name": "viewed",
        "type": "text",
        "label": "Content viewed",
        "default": "Viewed"
      },
      {
        "name": "notViewed",
        "type": "text",
        "label": "Content not viewed",
        "default": "Not viewed"
      },
      {
        "name": "showSolutions",
        "type": "text",
        "label": "Show solutions button",
        "default": "Show solutions"
      },
      {
        "name": "retry",
        "type": "text",
        "label": "Retry button",
        "default": "Retry"
      }
    ]
  },
  {
    "name": "a11y",
    "type": "group",
    "label": "Accessibility texts",
    "common": true,
    "fields": [
      {
        "name": "score",
        "type": "text",
        "label": "Score",
        "default": "Your score"
      },
      {
        "name": "previousContent",
        "type": "text",
        "label": "Previous content",
        "default": "Go to previous content."
      },
      {
        "name": "nextContent",
        "type": "text",
        "label": "Next content",
        "default": "Go to next content."
      },
      {
        "name": "movedTo",
        "type": "text",
        "label": "Moved to page",
        "default": "Moved to page @current of @total.",
        "description": "@current and @total are placeholders and will be replaced by the respective values."
      },
      {
        "name": "navigationTop",
        "type": "text",
        "label": "Top navigation",
        "default": "Top navigation bar"
      },
      {
        "name": "navigationBottom",
        "type": "text",
        "label": "Bottom navigation",
        "default": "Bottom navigation bar"
      },
      {
        "name": "mute",
        "type": "text",
        "label": "Mute audio",
        "default": "Mute audio"
      },
      {
        "name": "unmute",
        "type": "text",
        "label": "Unmute audio",
        "default": "Unmute audio"
      },
      {
        "name": "settings",
        "type": "text",
        "label": "Settings",
        "default": "Open settings"
      },
      {
        "name": "finish",
        "type": "text",
        "label": "Finish",
        "default": "Finish and show results"
      },
      {
        "name": "enterFullscreen",
        "type": "text",
        "label": "Enter fullscreen",
        "default": "Enter fullscreen mode"
      },
      {
        "name": "exitFullscreen",
        "type": "text",
        "label": "Exit fullscreen",
        "default": "Exit fullscreen mode"
      }
    ]
  }
]
